  "cards": [
    {
      "dot": "cyan",
      "title": "Task and Request Flow",
      "items": [
        "The job orders ingest_papers, enrich_bibliography, then build_graph; run_id is passed between tasks.",
        "Ingestion accepts a topic, count, ranking criterion, optional date/category filters, and environment."
      ]
    },
    {
      "dot": "violet",
      "title": "Enrichment Behavior",
      "items": [
        "The chat model returns structured tags and a short summary through tool calling.",
        "Semantic Scholar is queried in batch first; OpenAlex is used only when a paper has no Scholar bibliography."
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence and Trust",
      "items": [
        "Unity Catalog stores paper and enrichment Delta data plus downloaded PDFs in a Volume.",
        "Graph publication reads a completed run and writes versioned nodes, edges, and build metadata to separate Delta tables.",
        "Public scholarly providers sit outside the Databricks workspace boundary."
      ]
    }
  ]
